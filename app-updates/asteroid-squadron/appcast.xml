    <item>
      <title>1.35</title>
      <pubDate>Thu, 19 Nov 2026 01:51:57 +0000</pubDate>
      <link>https://github.com/brindy/AsteroidSquadron/releases/tag/v1.35</link>
      <sparkle:version>38</sparkle:version>
